# Replace creativity.example and certificate paths for the domain you control.
# Obtain a certificate separately. Validate with nginx -t before reloading.
server {
    listen 80;
    server_name creativity.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name creativity.example;
    ssl_certificate /etc/letsencrypt/live/creativity.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/creativity.example/privkey.pem;
    client_max_body_size 28m;
    location / {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
